# COSMIC Premium Bot configuration
# NEVER share your real .env file or bot token.
BOT_TOKEN=

# Primary bot owner IDs (comma-separated if you ever need more than one)
OWNER_IDS=1293127492982407195
PRIMARY_OWNER_ID=1293127492982407195

# Bot identity
BOT_NAME=Cosmic
PREFIX=,

# Optional links (leave blank if you do not have them yet)
SUPPORT_SERVER_URL=
DASHBOARD_URL=
TOS_URL=
PRIVACY_URL=
VOTE_URL=

# Cosmic Logs — create a Discord webhook and paste its URL here.
COSMIC_LOG_WEBHOOK_URL=
# Optional public URL for the Cosmic logo. If blank, the bundled logo is sent as an embed attachment.
COSMIC_LOGO_URL=
COSMIC_LOGO_PATH=assets/cosmic_logo.png

# Optional runtime settings
STATUS_TEXT=Cosmic • Multi-Purpose
LOG_LEVEL=INFO
